{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "es2016",                                 
    "module": "commonjs",                            
    "esModuleInterop": true,                             
    "forceConsistentCasingInFileNames": true,           
    "strict": true,  
    "outDir": "./dist",                                    
    "skipLibCheck": true,
     "paths": {
      "@services/*": ["./services/*"],
      "@types/*": ["./types/*"]
    },
  },
  "exclude": ["test", "dist", "node_modules"]
}
