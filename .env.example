AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ENVIRONMENT=
SQS_SIGNING_QUEUE_URL=

# Sentry (optional — app runs fine without it)
SENTRY_DSN=

# EJBCA — GetSign Signing CA
EJBCA_REST_BASE=https://ejbca:8443/ejbca/ejbca-rest-api/v1
EJBCA_ADMIN_P12=./superadmin.p12
EJBCA_ADMIN_PASSPHRASE=Root@jetsign
EJBCA_SIGNING_CA=GetSign Signing CA
EJBCA_CERT_PROFILE=GetSignSigning
EJBCA_EE_PROFILE=GetSignSigning

# Keystores — per-company P12 files at {KEYSTORE_DIR}/{accountId}.p12
KEYSTORE_DIR=/keystores
KEYSTORE_PASSWORD=changeit
