{
  "name": "getsign-flow_service",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "ts-node-dev src/index.ts",
    "build": "tsc && npm run copy-public",
    "copy-public": "cp -r src/public dist/",
    "serve": "node dist/index.js",
    "test": "NODE_ENV=test ENVIRONMENT=development AWS_REGION=us-east-1 AWS_ACCESS_KEY_ID=test AWS_SECRET_ACCESS_KEY=test SQS_SIGNING_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/local SENTRY_DSN= KEYSTORE_DIR=/tmp/getsign-flow-test/keystores CA_DIR=/tmp/getsign-flow-test/ca JOBS_DIR=/tmp/getsign-flow-test/jobs KEYSTORE_PASSWORD=test-password SIGN_API_TOKEN=test-token node --require ts-node/register/transpile-only --test --test-concurrency=1 --test-force-exit test/*.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.830.0",
    "@aws-sdk/client-sqs": "^3.835.0",
    "@aws-sdk/s3-request-presigner": "^3.830.0",
    "@sentry/node": "^10.23.0",
    "@sentry/profiling-node": "^10.23.0",
    "@signpdf/placeholder-pdf-lib": "^3.3.0",
    "@signpdf/signer-p12": "^3.3.0",
    "@signpdf/signpdf": "^3.3.0",
    "@types/formidable": "^3.4.5",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.9.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "form-data": "^4.0.2",
    "formidable": "^3.5.4",
    "fs": "^0.0.1-security",
    "morgan": "^1.10.1",
    "node-forge": "^1.3.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.2",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.15.31",
    "@types/node-forge": "^1.3.11",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  },
  "ts-node-dev": {
    "ignore": [
      "src/tmp"
    ]
  }
}
